{
  "consumer": {
    "name": "wd-website-nextjs"
  },
  "interactions": [
    {
      "description": "a contact submission with an invalid phone number",
      "providerStates": [
        {
          "name": "the portal-API rejects submissions that fail input validation"
        }
      ],
      "request": {
        "body": {
          "district": "Thrissur",
          "email": "pact-test@example.com",
          "leadSource": "website_contact",
          "message": "Interested in a 3BHK build",
          "name": "Audit Customer Test",
          "phone": "123",
          "projectType": "residential",
          "state": "Kerala"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/leads/contact"
      },
      "response": {
        "body": {
          "errorCode": "VALIDATION_ERROR",
          "success": false,
          "validationErrors": {
            "phone": "Enter a valid phone number"
          }
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.errorCode": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.validationErrors": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          },
          "header": {
            "Content-Type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 400
      }
    },
    {
      "description": "a valid contact-form submission",
      "providerStates": [
        {
          "name": "the portal-API is up and accepting public contact submissions"
        }
      ],
      "request": {
        "body": {
          "district": "Thrissur",
          "email": "pact-test@example.com",
          "leadSource": "website_contact",
          "message": "Interested in a 3BHK build",
          "name": "Audit Customer Test",
          "phone": "9876543210",
          "projectType": "residential",
          "state": "Kerala"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/leads/contact"
      },
      "response": {
        "body": {
          "data": 123,
          "message": "Your inquiry has been submitted successfully. We will contact you shortly.",
          "success": true
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.data": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.message": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          },
          "header": {
            "Content-Type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "16.5.0"
    },
    "pactRust": {
      "ffi": "0.5.4",
      "models": "1.3.11"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "wd-portal-api"
  }
}